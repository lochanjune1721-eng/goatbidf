# ---------------------------------------------------------------------------
# GOAT.lol — environment variables
#
# NEVER put real values in this file. It is committed to a public repository.
# Copy it to .env (git-ignored) for local work, and set the real values in
# Vercel: Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Dashboard -> Project Settings -> API

# Your project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The "anon" / publishable key. Safe to be public — it ships in every browser
# and is what /api/config hands to the front end.
SUPABASE_ANON_KEY=

# The "service_role" / secret key. SERVER ONLY. It bypasses row-level security,
# so anyone holding it can read, change or delete the whole database.
# Never commit it, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal ----------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials.
# Use the Sandbox app while testing, then the Live app when you go live.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" for test payments, "live" for real money. Defaults to sandbox.
PAYPAL_ENV=sandbox

# --- Optional --------------------------------------------------------------

# Currency for prices and PayPal charges. Must be one PayPal supports.
CURRENCY=USD

# Password for /admin.html.
ADMIN_PASSWORD=
